# next dev 전용 (저장소에 포함). 프론트만 로컬에서 띄우고 API는 운영 서버를 봅니다.
# 개인/배포용 덮어쓰기: .env.local (git 무시) — 이 파일보다 우선합니다.
#
NEXT_PUBLIC_API_BASE_URL=https://traceapp.site
# 트렌드 탭(/trends) 로컬 검증 시 true
NEXT_PUBLIC_FEATURE_TRENDS=true

# Sentry DSN은 public client key입니다. .env.local에서 덮어쓸 수 있습니다.
NEXT_PUBLIC_SENTRY_DSN=https://eff8191aa4a5ddb71d0cbfa926ee89a4@o4511437841498112.ingest.us.sentry.io/4511437846151169
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05